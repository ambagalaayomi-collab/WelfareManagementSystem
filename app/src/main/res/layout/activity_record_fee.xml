<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="#2E7D32"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="32dp">

            <TextView
                android:text="Record Fee"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Monthly member fee collection"
                android:textColor="#E8F5E9"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerMember"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtFeeAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Fee amount"
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtMonth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Month  eg: June 2026"
            android:textColor="#000000"
            android:padding="16dp"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtPaidDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Paid date  eg: 2026/06/28"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <Button
            android:id="@+id/btnRecordPayment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:text="RECORD PAYMENT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <TextView
            android:text="Payment Status"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnViewFees"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:text="Paid"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:backgroundTint="#2E7D32"/>

        <LinearLayout
            android:id="@+id/paymentStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>