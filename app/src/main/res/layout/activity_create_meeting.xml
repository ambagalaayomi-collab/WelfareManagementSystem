<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:background="#2E7D32"
            android:paddingStart="22dp"
            android:paddingTop="32dp">

            <TextView
                android:text="Create Meeting"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Add meeting announcement"
                android:textColor="#E8F5E9"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtMeetingTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:hint="Meeting title"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtMeetingDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Date"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtMeetingTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Time"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <EditText
            android:id="@+id/edtMeetingDescription"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:hint="Description"
            android:padding="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_box" />

        <Button
            android:id="@+id/btnCreateMeeting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:text="CREATE MEETING"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

    </LinearLayout>
</ScrollView>