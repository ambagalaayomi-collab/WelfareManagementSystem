<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="vertical"
        android:background="#2E7D32"
        android:paddingStart="24dp"
        android:paddingTop="32dp">

        <TextView
            android:text="Add Member"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Save member information"
            android:textColor="#E8F5E9"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <EditText
            android:id="@+id/edtName"
            android:hint="Full name"
            android:background="@drawable/input_box"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="52dp" />

        <EditText
            android:id="@+id/edtNic"
            android:hint="NIC number"
            android:background="@drawable/input_box"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="52dp" />

        <EditText
            android:id="@+id/edtPhone"
            android:hint="Phone number"
            android:background="@drawable/input_box"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="52dp" />

        <EditText
            android:id="@+id/edtAddress"
            android:hint="Address"
            android:background="@drawable/input_box"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="52dp" />

        <EditText
            android:id="@+id/edtJoinDate"
            android:hint="Join date"
            android:background="@drawable/input_box"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="52dp" />

        <Button
            android:id="@+id/btnSaveMember"
            android:text="SAVE MEMBER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="40dp"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

    </LinearLayout>

</LinearLayout>